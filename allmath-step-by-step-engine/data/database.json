  "calculations": [
    {
      "id": 1792494090771,
      "created_at": "2026-10-20T11:01:30.771Z",
      "title": "1^3+2^3+3^3+.......+n^3=n^2(n+1)/4,",
      "type": "expression",
      "query": "1^3+2^3+3^3+.......+n^3=n^2(n+1)/4,γnϵN.",
      "answer": "Proved by Mathematical Induction for all n ∈ N",
      "steps": [
        {
          "label": "Given Proposition P(n)",
          "katex": "P(n): 1^3 + 2^3 + 3^3 + \\dots + n^3 = \\frac{n^2(n+1)^2}{4}"
        },
        {
          "label": "Step 1: Base Case — Check for n = 1",
          "katex": "\\text{Left Hand Side (L.H.S)} = 1^3 = 1"
        },
        {
          "label": "Step 2: Evaluate Right Hand Side (R.H.S) for n = 1",
          "katex": "\\text{R.H.S} = \\frac{1^2(1+1)^2}{4} = \\frac{1 \\times 4}{4} = 1"
        },
        {
          "label": "Step 3: Base Case Conclusion",
          "katex": "\\text{Since L.H.S} = \\text{R.H.S} = 1, \\text{ the proposition } P(1) \\text{ is True.}"
        },
        {
          "label": "Step 4: Induction Hypothesis — Assume true for n = k",
          "katex": "P(k): 1^3 + 2^3 + 3^3 + \\dots + k^3 = \\frac{k^2(k+1)^2}{4} quad \\text{--- (Equation 1)}"
        },
        {
          "label": "Step 5: Induction Step — To prove true for n = k + 1",
          "katex": "P(k+1): 1^3 + 2^3 + \\dots + k^3 + (k+1)^3 = \\frac{(k+1)^2((k+1)+1)^2}{4}"
        },
        {
          "label": "Step 6: Target expression on R.H.S",
          "katex": "\\text{Required R.H.S} = \\frac{(k+1)^2(k+2)^2}{4}"
        },
        {
          "label": "Step 7: Add (k+1)³ to both sides of Equation 1",
          "katex": "1^3 + 2^3 + \\dots + k^3 + (k+1)^3 = \\frac{k^2(k+1)^2}{4} + (k+1)^3"
        },
        {
          "label": "Step 8: Factor out common term (k+1)²",
          "katex": "= (k+1)^2 \\left[ \\frac{k^2}{4} + (k+1) \\right]"
        },
        {
          "label": "Step 9: Take LCM inside the brackets",
          "katex": "= (k+1)^2 \\left[ \\frac{k^2 + 4(k+1)}{4} \\right]"
        },
        {
          "label": "Step 10: Expand numerator inside bracket",
          "katex": "= \\frac{(k+1)^2(k^2 + 4k + 4)}{4}"
        },
        {
          "label": "Step 11: Factorize quadratic k² + 4k + 4 as (k+2)²",
          "katex": "= \\frac{(k+1)^2(k+2)^2}{4} = \\text{R.H.S}"
        },
        {
          "label": "Step 12: Final Conclusion",
          "katex": "\\text{Since } P(k+1) \\text{ is true whenever } P(k) \\text{ is true, } P(n) \\text{ holds } \\forall n \\in \\mathbb{N}."
        }
      ]
    }
  ]
}