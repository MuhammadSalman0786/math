      "title": "\\int_{0}^{\\infty} \\frac{1}{1 + x^2}",
      "type": "expression",
      "query": "\\int_{0}^{\\infty} \\frac{1}{1 + x^2} \\, dx \\quad \\text{and} \\quad \\int_{0}^{1} \\frac{\\ln(x)}{\\sqrt{x}} \\, dx",
      "answer": "\\frac{\\pi}{2}",
      "steps": [
        {
          "label": "Given improper integral:",
          "katex": "\\int_0^\\infty \\frac{1}{1 + x^2} \\, dx = \\lim_{b \\to \\infty} [\\arctan(x)]_0^b"
        },
        {
          "label": "Step 1: Evaluate limits:",
          "katex": "\\lim_{b \\to \\infty} \\arctan(b) - \\arctan(0) = \\frac{\\pi}{2} - 0 = \\frac{\\pi}{2}"
        }
      ]
