      "title": "AC/DC: 220V (peak_to_dc)",
      "type": "acdc",
      "query": "220V",
      "answer": "V_{DC} = 70.0282 V",
      "steps": [
        {
          "label": "Step 1: Given Peak AC Voltage (V_peak)",
          "katex": "V_{peak} = 220\\text{ V}"
        },
        {
          "label": "Step 2: Circuit Configuration",
          "katex": "\\text{Half-Wave Rectifier (Single Diode Configuration)}"
        },
        {
          "label": "Step 3: Average DC Output Voltage Formula",
          "katex": "V_{DC} = \\frac{V_{peak}}{\\pi} \\approx 0.3183 \\times V_{peak}"
        },
        {
          "label": "Step 4: Compute Output DC Voltage",
          "katex": "V_{DC} = \\frac{220}{\\pi} = 70.0282\\text{ V}"
        },
        {
          "label": "Step 5: Equivalent RMS Voltage for Half-Wave",
          "katex": "V_{RMS} = \\frac{V_{peak}}{2} = \\frac{220}{2} = 110.0000\\text{ V}"
        },
        {
          "label": "Step 6: Peak-to-Peak Voltage (V_PP)",
          "katex": "V_{PP} = 2 \\times V_{peak} = 440.0000\\text{ V}"
        },
        {
          "label": "Step 7: Form Factor (V_RMS / V_DC)",
          "katex": "\\text{Form Factor} = \\frac{110.0000}{70.0282} = 1.5708"
        }
      ]
    },
