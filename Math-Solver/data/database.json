      "title": "\\text{Find eigenvalues and eigenvec",
      "type": "expression",
      "query": "\\text{Find eigenvalues and eigenvectors: } A = \\begin{bmatrix} 4 & -2 & 2 \\\\ 6 & -3 & 4 \\\\ 2 & -1 & 3 \\end{bmatrix}",
      "answer": "x = 2, \\; y = 1, \\; z = 2",
      "steps": [
        {
          "label": "Given matrix equation AX = B:",
          "katex": "\\begin{pmatrix} 2 & -1 & 3 \\\\ 1 & 1 & 1 \\\\ 3 & -2 & 5 \\end{pmatrix} \\begin{pmatrix} x \\\\ y \\\\ z \\end{pmatrix} = \\begin{pmatrix} 9 \\\\ 6 \\\\ 15 \\end{pmatrix}"
        },
        {
          "label": "Step 1: Compute determinant det(A):",
          "katex": "\\det(A) = 2(7) - (-1)(2) + 3(-5) = 14 + 2 - 15 = 1 \\neq 0"
        },
        {
          "label": "Step 2: Solve by Cramer's rule:",
          "katex": "x = \\frac{\\det(A_x)}{\\det(A)} = \\frac{2}{1} = 2, \\quad y = \\frac{\\det(A_y)}{\\det(A)} = 1, \\quad z = \\frac{\\det(A_z)}{\\det(A)} = 2"
        }
      ]
    },
