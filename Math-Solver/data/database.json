      "title": "\\int_{0}^{1} \\int_{y}^{1} e^{x^2} \\",
      "type": "expression",
      "query": "\\int_{0}^{1} \\int_{y}^{1} e^{x^2} \\, dx \\, dy",
      "answer": "\\frac{e - 1}{2}",
      "steps": [
        {
          "label": "Given double integral with non-elementary inner term:",
          "katex": "I = \\int_0^1 \\int_y^1 e^{x^2} \\, dx \\, dy"
        },
        {
          "label": "Step 1: Swap limits to 0 ≤ y ≤ x and 0 ≤ x ≤ 1:",
          "katex": "I = \\int_0^1 \\int_0^x e^{x^2} \\, dy \\, dx"
        },
        {
          "label": "Step 2: Integrate inner integral with respect to y:",
          "katex": "\\int_0^x e^{x^2} \\, dy = x e^{x^2}"
        },
        {
          "label": "Step 3: Evaluate outer integral with u = x²:",
          "katex": "\\int_0^1 x e^{x^2} \\, dx = \\left[ \\frac{1}{2}e^{x^2} \\right]_0^1 = \\frac{e - 1}{2}"
        }
      ]
    },
