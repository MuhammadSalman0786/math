      "query": "\\mathcal{L}\\left\\{ t^2 \\sin(3t) \\cdot u(t - \\pi) \\right\\}",
      "answer": "-e^{-\\pi s} \\left[ \\frac{18s^2 - 6(s^2+9)}{(s^2+9)^3} + 2\\pi \\frac{6s}{(s^2+9)^2} + \\pi^2 \\frac{3}{s^2+9} \\right]",
      "steps": [
        {
          "label": "Given Laplace transform:",
          "katex": "\\mathcal{L}\\{ t^2 \\sin(3t) u(t - \\pi) \\}"
        },
        {
          "label": "Step 1: Apply time-shift property e^(-πs) L{ f(t + π) }:",
          "katex": "= e^{-\\pi s} \\mathcal{L}\\{ (t + \\pi)^2 \\sin(3(t + \\pi)) \\} = -e^{-\\pi s} \\mathcal{L}\\{ (t^2 + 2\\pi t + \\pi^2)\\sin(3t) \\}"
        },
        {
          "label": "Step 2: Transform individual components:",
          "katex": "\\mathcal{L}\\{\\sin 3t\\} = \\frac{3}{s^2+9}, \\quad \\mathcal{L}\\{t\\sin 3t\\} = \\frac{6s}{(s^2+9)^2}, \\quad \\mathcal{L}\\{t^2\\sin 3t\\} = \\frac{18s^2 - 6(s^2+9)}{(s^2+9)^3}"
        }
      ]
    },
