      "id": 1792827222522,
      "created_at": "2026-10-24T07:33:42.522Z",
      "title": "\\int_{0}^{\\frac{\\pi}{2}} \\sin^5(\\th",
      "type": "expression",
      "query": "\\int_{0}^{\\frac{\\pi}{2}} \\sin^5(\\theta) \\cos^4(\\theta) \\, d\\theta = \\frac{1}{2} B\\left(3, \\frac{5}{2}\\right) = \\frac{\\Gamma(3)\\Gamma(2.5)}{2\\Gamma(5.5)}",
      "answer": "\\frac{8}{315}",
      "steps": [
        {
          "label": "Given trigonometric definite integral:",
          "katex": "\\int_0^{\\pi/2} \\sin^5(\\theta) \\cos^4(\\theta) \\, d\\theta"
        },
        {
          "label": "Step 1: Formula connecting trigonometric integrals to Beta function:",
          "katex": "\\int_0^{\\pi/2} \\sin^{2m-1}(\\theta) \\cos^{2n-1}(\\theta) \\, d\\theta = \\frac{1}{2} B(m, n) = \\frac{\\Gamma(m)\\Gamma(n)}{2\\Gamma(m+n)}"
        },
        {
          "label": "Step 2: Determine parameters m and n (2m - 1 = 5, 2n - 1 = 4):",
          "katex": "2m = 6 \\implies m = 3, \\quad 2n = 5 \\implies n = \\frac{5}{2}"
        },
        {
          "label": "Step 3: Evaluate Gamma function values:",
          "katex": "\\Gamma(3) = 2! = 2 \\\\[4pt] \\Gamma\\left(\\frac{5}{2}\\right) = \\frac{3}{2} \\cdot \\frac{1}{2} \\sqrt{\\pi} = \\frac{3}{4}\\sqrt{\\pi} \\\\[4pt] \\Gamma(m+n) = \\Gamma\\left(\\frac{11}{2}\\right) = \\frac{9}{2} \\cdot \\frac{7}{2} \\cdot \\frac{5}{2} \\cdot \\frac{3}{2} \\cdot \\frac{1}{2}\\sqrt{\\pi} = \\frac{945}{32}\\sqrt{\\pi}"
        },
        {
          "label": "Step 4: Compute exact fractional quotient:",
          "katex": "= \\frac{2 \\times \\left(\\frac{3}{4}\\sqrt{\\pi}\\right)}{2 \\times \\left(\\frac{945}{32}\\sqrt{\\pi}\\right)} = \\frac{3/4}{945/32} = \\frac{3}{4} \\times \\frac{32}{945} = \\frac{24}{945} = \\frac{8}{315}"
        },
        {
          "label": "Final Exact Evaluation:",
          "katex": "\\mathbf{\\int_0^{\\pi/2} \\sin^5(\\theta)\\cos^4(\\theta)\\,d\\theta = \\frac{8}{315}}"
        }
      ]
    },
